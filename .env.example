# DATABASE_URL is used by the map-data service (local dev compose).
# Set this to your production/Neon database URL.
DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host.neon.tech/dbname?sslmode=require

# Required for the ai-logic-service (AI policy scorecard & grounding)
GEMINI_API_KEY=your_gemini_api_key_here

# Override AI service URL (default: http://localhost:8003 for local dev, set to http://ai-logic:8003 in Docker)
# AI_SERVICE_URL=http://localhost:8003
